{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023", "dom"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["chrome-types", "node"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*", "esbuild.mjs"]
}
