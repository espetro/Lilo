{
	"manifest_version": 3,
	"name": "Lilo Companion",
	"version": "0.1.0",
	"description": "Exposes this browser's tabs and pages to the Lilo agent over native messaging.",
	"minimum_chrome_version": "116",
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": ["nativeMessaging", "tabs", "scripting", "storage"],
	"host_permissions": ["<all_urls>"],
	// Pins the extension id (the SHA-256 of this key's first half, hex mapped a-p), so the
	// native-messaging manifest's allowed_origins stays valid across unpacked reloads.
	"key": "",
	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	]
}
